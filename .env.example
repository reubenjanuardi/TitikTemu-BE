# ============================================
# TitikTemu Backend - Environment Configuration
# ============================================
# Copy this file to .env and fill in the values

# ============================================
# Service Ports
# ============================================
GATEWAY_PORT=3000
AUTH_SERVICE_PORT=3001
EVENT_SERVICE_PORT=3002
ATTENDANCE_SERVICE_PORT=3003
VENUE_SERVICE_PORT=3004

# ============================================
# Service URLs (Internal Communication)
# ============================================
AUTH_SERVICE_URL=http://localhost:3001
EVENT_SERVICE_URL=http://localhost:3002
ATTENDANCE_SERVICE_URL=http://localhost:3003
VENUE_SERVICE_URL=http://localhost:3004

# ============================================
# Database URLs (PostgreSQL via Supabase)
# Each service has its own schema
# ============================================
AUTH_DATABASE_URL=postgresql://user:password@host:5432/database?schema=auth_schema
EVENT_DATABASE_URL=postgresql://user:password@host:5432/database?schema=event_schema
ATTENDANCE_DATABASE_URL=postgresql://user:password@host:5432/database?schema=attendance_schema

# ============================================
# JWT Configuration
# ============================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=24h

# ============================================
# External Integration (LOGe System)
# ============================================
LOGE_GRAPHQL_URL=http://localhost:4000/graphql

# ============================================
# Environment
# ============================================
NODE_ENV=development
