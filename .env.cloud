# Cloud PostgreSQL Environment Configuration
# Use this when your database is hosted on Supabase, AWS RDS, Azure, Google Cloud SQL, etc.

# ============================================
# Environment
# ============================================
NODE_ENV=production

# ============================================
# CLOUD DATABASE URLS
# Replace with your actual cloud database connection strings
# ============================================

# Supabase Example:
# postgresql://postgres.xxxxx:password@aws-0-xxxxx.pooling.supabase.co:6543/postgres?schema=auth_schema

# AWS RDS Example:
# postgresql://admin:password@titiktemu-db.xxxxx.us-east-1.rds.amazonaws.com:5432/postgres?schema=auth_schema

# Azure Example:
# postgresql://pgadmin@titiktemu:password@titiktemu.postgres.database.azure.com:5432/postgres?schema=auth_schema

# Auth Service Database URL
AUTH_DATABASE_URL=postgresql://postgres.xxxxx:your-password@your-cloud-host:6543/postgres?schema=auth_schema

# Event Service Database URL
EVENT_DATABASE_URL=postgresql://postgres.xxxxx:your-password@your-cloud-host:6543/postgres?schema=event_schema

# Attendance Service Database URL
ATTENDANCE_DATABASE_URL=postgresql://postgres.xxxxx:your-password@your-cloud-host:6543/postgres?schema=attendance_schema

# ============================================
# JWT Configuration
# ============================================
JWT_SECRET=your-super-secret-jwt-key-that-must-be-at-least-32-characters-long

# ============================================
# Service URLs (Docker internal network)
# ============================================
AUTH_SERVICE_URL=http://auth-service:3001
EVENT_SERVICE_URL=http://event-service:3002
ATTENDANCE_SERVICE_URL=http://attendance-service:3003
VENUE_SERVICE_URL=http://venue-consumer-service:3004

# ============================================
# External Service URLs
# ============================================
LOGE_GRAPHQL_URL=http://localhost:5000/graphql

# ============================================
# Port Configuration (exposed to host)
# ============================================
GATEWAY_PORT=3000
AUTH_SERVICE_PORT=3001
EVENT_SERVICE_PORT=3002
ATTENDANCE_SERVICE_PORT=3003
VENUE_SERVICE_PORT=3004

# ============================================
# Optional: Individual Database Connection Parameters
# (Use if you prefer not to use full DATABASE_URL)
# ============================================
# DB_HOST=your-cloud-host.com
# DB_PORT=6543 (Supabase) or 5432 (others)
# DB_USER=your-username
# DB_PASSWORD=your-password
# DB_NAME=postgres

# ============================================
# Cloud Provider Specific Settings (Optional)
# ============================================

# Supabase Project Reference
# SUPABASE_PROJECT_REF=xxxxx

# AWS RDS Instance Endpoint
# AWS_RDS_ENDPOINT=titiktemu-db.xxxxx.rds.amazonaws.com

# Azure Server Name
# AZURE_DB_SERVER=titiktemu.postgres.database.azure.com

# Google Cloud SQL Instance
# GCP_CLOUD_SQL_INSTANCE=project:region:instance-name
