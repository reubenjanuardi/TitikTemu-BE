# API Gateway Environment Variables
# Copy to .env and configure

# Gateway Configuration
PORT=3000
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Microservice URLs
AUTH_SERVICE_URL=http://localhost:3001
EVENT_SERVICE_URL=http://localhost:3002
ATTENDANCE_SERVICE_URL=http://localhost:3003
VENUE_SERVICE_URL=http://localhost:3004

# LOGe External System (for GraphQL integration)
LOGE_GRAPHQL_URL=http://localhost:4000/graphql
