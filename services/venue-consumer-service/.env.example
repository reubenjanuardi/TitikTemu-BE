# Venue Consumer Service Environment Variables
# Copy to .env and configure

# Service Configuration
PORT=3004
NODE_ENV=development

# LOGe GraphQL API (External System)
LOGE_GRAPHQL_URL=http://localhost:4000/graphql
LOGE_API_KEY=your-loge-api-key-if-needed
LOGE_TIMEOUT=5000

# LOGe Incoming - Shared Secret for LOGe to authenticate with TitikTemu
LOGE_INCOMING_API_KEY=your-shared-secret-key-with-loge

# Internal Service URLs
EVENT_SERVICE_URL=http://localhost:3002
ATTENDANCE_SERVICE_URL=http://localhost:3003
