# Auth Service Environment Variables
# Copy to .env and configure

# Service Configuration
PORT=3001
NODE_ENV=development

# Database (PostgreSQL via Supabase - auth_schema)
DATABASE_URL=postgresql://user:password@host:5432/database?schema=auth_schema

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=24h
